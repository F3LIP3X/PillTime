# El árbol de Expo SDK 57 declara react-dom como peer dependency opcional
# con versiones incompatibles entre sí (@expo/router-server pide una y el
# proyecto resuelve otra). No afecta a esta app —es una dependencia de
# herramientas web que no usamos— pero hace fallar `npm install`/`npm ci`
# sin este flag, incluidos los builds de EAS, donde no hay forma de pasar
# argumentos sueltos a npm.
legacy-peer-deps=true
